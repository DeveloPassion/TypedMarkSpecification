{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developassion.github.io/TypedMarkSpecification/schema/note-type.schema.json",
  "title": "TypedMark note-type schema (<metadata_directory>/schemas/<note_type>.md frontmatter)",
  "description": "Local schema shape. Basename/default expansion, Reuse resolution, effective values, and template validity are semantic checks.",
  "type": "object",
  "required": [
    "specification_version",
    "description"
  ],
  "properties": {
    "specification_version": {
      "$ref": "defs.schema.json#/$defs/specification_version"
    },
    "note_type": {
      "$ref": "defs.schema.json#/$defs/slug"
    },
    "abstract": {
      "type": "boolean",
      "default": false
    },
    "extends": {
      "$ref": "defs.schema.json#/$defs/slug"
    },
    "label": {
      "$ref": "defs.schema.json#/$defs/non_empty_string"
    },
    "icon": {
      "$ref": "defs.schema.json#/$defs/non_empty_string"
    },
    "description": {
      "$ref": "defs.schema.json#/$defs/non_empty_string"
    },
    "unknown_field": {
      "$ref": "defs.schema.json#/$defs/validation_severity"
    },
    "count": {
      "$comment": "min <= max is a semantic check.",
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "storage": {
      "$ref": "defs.schema.json#/$defs/storage_block"
    },
    "template": {
      "$ref": "defs.schema.json#/$defs/template_block"
    },
    "mandatory_tags": {
      "$comment": "Inheritance, effective merge order, and tags-field compatibility are semantic checks.",
      "$ref": "defs.schema.json#/$defs/mandatory_tags"
    },
    "property_sets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "defs.schema.json#/$defs/slug"
      }
    },
    "exclude_property_sets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "defs.schema.json#/$defs/slug"
      }
    },
    "frontmatter_remove": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "defs.schema.json#/$defs/field_name"
      }
    },
    "frontmatter": {
      "default": {},
      "allOf": [
        {
          "$ref": "defs.schema.json#/$defs/frontmatter_block"
        },
        {
          "$ref": "defs.schema.json#/$defs/core_frontmatter_contract"
        }
      ]
    },
    "relationships": {
      "$ref": "defs.schema.json#/$defs/relationships_block"
    },
    "headings": {
      "$ref": "defs.schema.json#/$defs/headings_block"
    },
    "guidance": {
      "$ref": "defs.schema.json#/$defs/guidance_block"
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "defs.schema.json#/$defs/condition_rule"
      }
    }
  },
  "patternProperties": {
    "^x_[a-z][a-z0-9_]*(?![\\s\\S])": {}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "Only concrete note types may declare property-set composition references.",
      "if": {
        "properties": {
          "abstract": {
            "const": true
          }
        },
        "required": [
          "abstract"
        ]
      },
      "then": {
        "properties": {
          "property_sets": false,
          "exclude_property_sets": false,
          "frontmatter_remove": false
        }
      }
    },
    {
      "if": {
        "not": {
          "anyOf": [
            {
              "properties": {
                "abstract": {
                  "const": true
                }
              },
              "required": [
                "abstract"
              ]
            },
            {
              "required": [
                "extends"
              ]
            }
          ]
        }
      },
      "then": {
        "required": [
          "storage"
        ]
      }
    }
  ]
}
