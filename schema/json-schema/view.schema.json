{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developassion.github.io/TypedMarkSpecification/schema/view.schema.json",
  "title": "TypedMark saved view (<metadata_directory>/views/<view>.md frontmatter)",
  "description": "An embedded portable query or dataset reference plus a declarative presentation. Authoritative semantics: collection-model.md (Saved Views).",
  "type": "object",
  "required": [
    "specification_version",
    "view",
    "description",
    "presentation"
  ],
  "properties": {
    "specification_version": {
      "$ref": "defs.schema.json#/$defs/specification_version"
    },
    "view": {
      "$ref": "defs.schema.json#/$defs/slug"
    },
    "label": {
      "$ref": "defs.schema.json#/$defs/non_empty_string"
    },
    "description": {
      "$ref": "defs.schema.json#/$defs/non_empty_string"
    },
    "query": {
      "$ref": "query.schema.json"
    },
    "dataset": {
      "$ref": "defs.schema.json#/$defs/slug"
    },
    "presentation": {
      "$ref": "#/$defs/presentation"
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "required": [
        "query"
      ]
    },
    {
      "required": [
        "dataset"
      ]
    }
  ],
  "$defs": {
    "presentation": {
      "type": "object",
      "required": [
        "layout",
        "fields"
      ],
      "properties": {
        "layout": {
          "enum": [
            "table",
            "list",
            "cards",
            "board"
          ]
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/presented_field"
          }
        },
        "board": {
          "$ref": "#/$defs/board"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "layout": {
                "const": "board"
              }
            },
            "required": [
              "layout"
            ]
          },
          "then": {
            "required": [
              "board"
            ]
          },
          "else": {
            "not": {
              "required": [
                "board"
              ]
            }
          }
        }
      ]
    },
    "presented_field": {
      "type": "object",
      "required": [
        "column"
      ],
      "properties": {
        "column": {
          "$ref": "defs.schema.json#/$defs/field_name"
        },
        "label": {
          "$ref": "defs.schema.json#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "board": {
      "type": "object",
      "required": [
        "column",
        "columns"
      ],
      "properties": {
        "column": {
          "$ref": "defs.schema.json#/$defs/field_name"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/board_column"
          }
        },
        "unmapped_label": {
          "$ref": "defs.schema.json#/$defs/non_empty_string",
          "default": "Other"
        }
      },
      "additionalProperties": false
    },
    "board_column": {
      "type": "object",
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "label": {
          "$ref": "defs.schema.json#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    }
  }
}
