{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developassion.github.io/TypedMarkSpecification/schema/view.schema.json",
  "title": "TypedMark saved view (<metadata_directory>/views/<view>.md frontmatter)",
  "description": "An embedded portable query or dataset reference plus a declarative presentation. Authoritative semantics: datasets-and-views.md (Saved Views).",
  "type": "object",
  "required": [
    "specification_version",
    "view",
    "description",
    "presentation"
  ],
  "properties": {
    "specification_version": {
      "$ref": "defs.schema.json#/$defs/specification_version"
    },
    "view": {
      "$ref": "defs.schema.json#/$defs/slug"
    },
    "label": {
      "$ref": "defs.schema.json#/$defs/non_empty_string"
    },
    "description": {
      "$ref": "defs.schema.json#/$defs/non_empty_string"
    },
    "query": {
      "$ref": "query.schema.json"
    },
    "dataset": {
      "$ref": "defs.schema.json#/$defs/slug"
    },
    "presentation": {
      "$ref": "#/$defs/presentation"
    }
  },
  "patternProperties": {
    "^x_[a-z][a-z0-9_]*(?![\\s\\S])": {}
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "required": [
        "query"
      ]
    },
    {
      "required": [
        "dataset"
      ]
    }
  ],
  "$defs": {
    "presentation": {
      "type": "object",
      "required": [
        "layout",
        "fields"
      ],
      "properties": {
        "layout": {
          "enum": [
            "table",
            "list",
            "cards",
            "board",
            "tree",
            "calendar",
            "timeline"
          ]
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/presented_field"
          }
        },
        "board": {
          "$ref": "#/$defs/board"
        },
        "tree": {
          "$ref": "#/$defs/tree"
        },
        "calendar": {
          "$ref": "#/$defs/calendar"
        },
        "timeline": {
          "$ref": "#/$defs/timeline"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "layout": {
                "const": "board"
              }
            },
            "required": [
              "layout"
            ]
          },
          "then": {
            "required": [
              "board"
            ]
          },
          "else": {
            "not": {
              "required": [
                "board"
              ]
            }
          }
        },
        {
          "$comment": "CM-596",
          "if": {
            "properties": {
              "layout": {
                "const": "calendar"
              }
            },
            "required": [
              "layout"
            ]
          },
          "then": {
            "required": [
              "calendar"
            ]
          },
          "else": {
            "not": {
              "required": [
                "calendar"
              ]
            }
          }
        },
        {
          "$comment": "CM-596",
          "if": {
            "properties": {
              "layout": {
                "const": "timeline"
              }
            },
            "required": [
              "layout"
            ]
          },
          "then": {
            "required": [
              "timeline"
            ]
          },
          "else": {
            "not": {
              "required": [
                "timeline"
              ]
            }
          }
        },
        {
          "$comment": "CM-582",
          "if": {
            "properties": {
              "layout": {
                "const": "tree"
              }
            },
            "required": [
              "layout"
            ]
          },
          "then": {
            "required": [
              "tree"
            ]
          },
          "else": {
            "not": {
              "required": [
                "tree"
              ]
            }
          }
        }
      ]
    },
    "presented_field": {
      "type": "object",
      "required": [
        "column"
      ],
      "properties": {
        "column": {
          "$ref": "defs.schema.json#/$defs/field_name"
        },
        "label": {
          "$ref": "defs.schema.json#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "board": {
      "type": "object",
      "required": [
        "column",
        "columns"
      ],
      "properties": {
        "column": {
          "$ref": "defs.schema.json#/$defs/field_name"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/board_column"
          }
        },
        "unmapped_label": {
          "$ref": "defs.schema.json#/$defs/non_empty_string",
          "default": "Other"
        },
        "lanes": {
          "$ref": "#/$defs/board_lanes"
        },
        "writable": {
          "$comment": "Column moves write the column field (CM-576, CM-577); assignability is semantic.",
          "type": "boolean",
          "default": false
        },
        "rank": {
          "$comment": "A projected number field ordering rows within each column (CM-578).",
          "$ref": "defs.schema.json#/$defs/field_name"
        }
      },
      "additionalProperties": false
    },
    "tree": {
      "$comment": "Rows under their parents through a projected link column (CM-583); link-typed projection and assignability are semantic.",
      "type": "object",
      "required": [
        "parent"
      ],
      "properties": {
        "parent": {
          "$ref": "defs.schema.json#/$defs/field_name"
        },
        "context": {
          "$comment": "Out-of-result ancestors as read-only context rows (CM-590, CM-591).",
          "enum": [
            "none",
            "ancestors"
          ],
          "default": "none"
        },
        "writable": {
          "$comment": "Moves write or remove the parent link, or one occurrence's item in a list of parents (CM-593, CM-594, CM-617, CM-618).",
          "type": "boolean",
          "default": false
        },
        "rollups": {
          "$comment": "Display-only values derived from children (CM-609 to CM-616); column typing and uniqueness are semantic.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tree_rollup"
          }
        }
      },
      "additionalProperties": false
    },
    "tree_rollup": {
      "type": "object",
      "required": [
        "column",
        "aggregate"
      ],
      "properties": {
        "column": {
          "$ref": "defs.schema.json#/$defs/field_name"
        },
        "aggregate": {
          "enum": [
            "sum",
            "min",
            "max",
            "count",
            "weighted_mean"
          ]
        },
        "weight": {
          "$ref": "defs.schema.json#/$defs/field_name"
        },
        "state": {
          "$ref": "defs.schema.json#/$defs/field_name"
        },
        "done_value": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "dependentRequired": {
        "state": [
          "done_value"
        ],
        "done_value": [
          "state"
        ]
      },
      "allOf": [
        {
          "$comment": "CM-611",
          "if": {
            "properties": {
              "aggregate": {
                "const": "weighted_mean"
              }
            }
          },
          "then": {
            "required": [
              "weight"
            ]
          },
          "else": {
            "not": {
              "required": [
                "weight"
              ]
            }
          }
        },
        {
          "$comment": "CM-615",
          "if": {
            "properties": {
              "aggregate": {
                "const": "count"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "done_value"
              ]
            }
          }
        }
      ]
    },
    "calendar": {
      "$comment": "Rows on the days of one or more date dimensions (CM-597 to CM-600); date typing and assignability are semantic.",
      "type": "object",
      "required": [
        "dates"
      ],
      "properties": {
        "dates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/calendar_date"
          }
        },
        "backlog": {
          "type": "boolean",
          "default": false
        },
        "writable": {
          "$comment": "Moves write or remove one date (CM-605, CM-606).",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "calendar_date": {
      "type": "object",
      "required": [
        "column"
      ],
      "properties": {
        "column": {
          "$ref": "defs.schema.json#/$defs/field_name"
        },
        "label": {
          "$ref": "defs.schema.json#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    },
    "timeline": {
      "$comment": "Rows as spans from start to an optional end (CM-601 to CM-604); date typing and assignability are semantic.",
      "type": "object",
      "required": [
        "start"
      ],
      "properties": {
        "start": {
          "$ref": "defs.schema.json#/$defs/field_name"
        },
        "end": {
          "$ref": "defs.schema.json#/$defs/field_name"
        },
        "backlog": {
          "type": "boolean",
          "default": false
        },
        "writable": {
          "$comment": "Moves shift or resize the span (CM-605, CM-607).",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "board_lanes": {
      "$comment": "Swimlanes over one orderable scalar projected column; lane values come from the rows (CM-569, CM-570).",
      "type": "object",
      "required": [
        "column"
      ],
      "properties": {
        "column": {
          "$ref": "defs.schema.json#/$defs/field_name"
        },
        "empty_label": {
          "$ref": "defs.schema.json#/$defs/non_empty_string",
          "default": "None"
        }
      },
      "additionalProperties": false
    },
    "board_column": {
      "type": "object",
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "label": {
          "$ref": "defs.schema.json#/$defs/non_empty_string"
        }
      },
      "additionalProperties": false
    }
  }
}
