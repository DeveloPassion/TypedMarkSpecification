{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developassion.github.io/TypedMarkSpecification/schema/automation.schema.json",
  "title": "TypedMark automation (<metadata_directory>/automations/<automation>.md frontmatter)",
  "description": "Declarative automation rule shape. Authoritative semantics: collection-model.md and managed-notes-and-properties.md.",
  "type": "object",
  "required": [
    "specification_version",
    "automation",
    "description",
    "trigger",
    "actions"
  ],
  "properties": {
    "specification_version": {
      "$ref": "defs.schema.json#/$defs/specification_version"
    },
    "automation": {
      "$ref": "defs.schema.json#/$defs/slug"
    },
    "description": {
      "$ref": "defs.schema.json#/$defs/non_empty_string"
    },
    "priority": {
      "type": "integer",
      "default": 0
    },
    "trigger": {
      "$ref": "#/$defs/trigger"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "when": {
      "$ref": "defs.schema.json#/$defs/frontmatter_predicate_block"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "failure": {
      "const": "abort",
      "default": "abort"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "trigger": {
            "properties": {
              "scope_transition": {
                "enum": [
                  "enters",
                  "leaves"
                ]
              }
            },
            "required": [
              "scope_transition"
            ]
          }
        },
        "required": [
          "trigger"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "scope"
            ]
          },
          {
            "required": [
              "when"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "trigger": {
            "properties": {
              "kind": {
                "const": "schedule"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "trigger"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "scope"
              ]
            },
            {
              "required": [
                "when"
              ]
            }
          ]
        }
      },
      "then": {
        "properties": {
          "actions": {
            "items": {
              "properties": {
                "kind": {
                  "const": "create_note"
                }
              },
              "required": [
                "kind"
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "field_change_predicate": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "from": {},
        "to": {}
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "from"
          ]
        },
        {
          "required": [
            "to"
          ]
        }
      ]
    },
    "changed_fields": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "defs.schema.json#/$defs/field_name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/field_change_predicate"
      }
    },
    "event_trigger": {
      "type": "object",
      "required": [
        "kind",
        "event"
      ],
      "properties": {
        "kind": {
          "const": "event"
        },
        "event": {
          "enum": [
            "note.created",
            "note.updated",
            "note.moved",
            "note.archived",
            "note.deleted"
          ]
        },
        "changed": {
          "$ref": "#/$defs/changed_fields"
        },
        "scope_transition": {
          "enum": [
            "matches_after",
            "enters",
            "leaves"
          ],
          "default": "matches_after"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "event": {
                "const": "note.updated"
              }
            },
            "required": [
              "event"
            ]
          },
          "else": {
            "not": {
              "required": [
                "changed"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "scope_transition": {
                "enum": [
                  "enters",
                  "leaves"
                ]
              }
            },
            "required": [
              "scope_transition"
            ]
          },
          "then": {
            "properties": {
              "event": {
                "enum": [
                  "note.updated",
                  "note.moved",
                  "note.archived"
                ]
              }
            }
          }
        }
      ]
    },
    "daily_schedule": {
      "type": "object",
      "required": [
        "cadence",
        "at"
      ],
      "properties": {
        "cadence": {
          "const": "daily"
        },
        "at": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      },
      "additionalProperties": false
    },
    "weekly_schedule": {
      "type": "object",
      "required": [
        "cadence",
        "weekday",
        "at"
      ],
      "properties": {
        "cadence": {
          "const": "weekly"
        },
        "weekday": {
          "enum": [
            "monday",
            "tuesday",
            "wednesday",
            "thursday",
            "friday",
            "saturday",
            "sunday"
          ]
        },
        "at": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      },
      "additionalProperties": false
    },
    "monthly_schedule": {
      "type": "object",
      "required": [
        "cadence",
        "day",
        "at"
      ],
      "properties": {
        "cadence": {
          "const": "monthly"
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "at": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      },
      "additionalProperties": false
    },
    "schedule_trigger": {
      "type": "object",
      "required": [
        "kind",
        "schedule"
      ],
      "properties": {
        "kind": {
          "const": "schedule"
        },
        "schedule": {
          "oneOf": [
            {
              "$ref": "#/$defs/daily_schedule"
            },
            {
              "$ref": "#/$defs/weekly_schedule"
            },
            {
              "$ref": "#/$defs/monthly_schedule"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "trigger": {
      "oneOf": [
        {
          "$ref": "#/$defs/event_trigger"
        },
        {
          "$ref": "#/$defs/schedule_trigger"
        }
      ]
    },
    "scope": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "note_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "defs.schema.json#/$defs/slug"
          }
        },
        "path": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "equals": {
              "$ref": "defs.schema.json#/$defs/collection_relative_path"
            },
            "under": {
              "type": "string",
              "minLength": 2,
              "allOf": [
                {
                  "pattern": "/$"
                },
                {
                  "not": {
                    "pattern": "^/"
                  }
                },
                {
                  "not": {
                    "pattern": "\\\\"
                  }
                },
                {
                  "not": {
                    "pattern": "(^|/)\\.\\.?(/|$)"
                  }
                }
              ]
            },
            "regex": {
              "$ref": "defs.schema.json#/$defs/non_empty_string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "field",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "set_field"
            },
            "field": {
              "$ref": "defs.schema.json#/$defs/field_name"
            },
            "value": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "tag"
          ],
          "properties": {
            "kind": {
              "const": "add_tag"
            },
            "tag": {
              "$ref": "defs.schema.json#/$defs/tag"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "tag"
          ],
          "properties": {
            "kind": {
              "const": "remove_tag"
            },
            "tag": {
              "$ref": "defs.schema.json#/$defs/tag"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "move_note"
            },
            "path": {
              "allOf": [
                {
                  "$ref": "defs.schema.json#/$defs/collection_relative_path"
                },
                {
                  "pattern": "\\.md$"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "archive_note"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "note_type"
          ],
          "properties": {
            "kind": {
              "const": "create_note"
            },
            "note_type": {
              "$ref": "defs.schema.json#/$defs/slug"
            },
            "values": {
              "type": "object",
              "propertyNames": {
                "$ref": "defs.schema.json#/$defs/field_name"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "logical_delete_note",
                "hard_delete_note"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
