{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developassion.github.io/TypedMarkSpecification/schema/conformance-query.schema.json",
  "title": "Non-normative query conformance cases",
  "description": "Harness data outside the collection. Adapters normalize conceptual query results to these test fields; this is not a query interchange contract.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["name", "query_version", "query", "rules"],
    "properties": {
      "name": { "$ref": "defs.schema.json#/$defs/slug" },
      "query_version": { "$ref": "defs.schema.json#/$defs/semver" },
      "query": { "$ref": "query.schema.json" },
      "rules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z]{2,3}-[1-9][0-9]*$" } },
      "expected_error": { "type": "string", "pattern": "^[A-Z]{2,3}-[1-9][0-9]*$" },
      "expected_result": { "$ref": "#/$defs/result" }
    },
    "additionalProperties": false,
    "oneOf": [ { "required": ["expected_error"], "not": { "required": ["expected_result"] } }, { "required": ["expected_result"], "not": { "required": ["expected_error"] } } ]
  },
  "$defs": {
    "rows": { "type": "array", "items": { "type": "object" } },
    "reason": {
      "type": "object", "required": ["code", "rule_id"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "rule_id": { "type": "string", "pattern": "^[A-Z]{2,3}-[1-9][0-9]*$" },
        "field": { "$ref": "defs.schema.json#/$defs/dotted_field_path" },
        "message": { "$ref": "defs.schema.json#/$defs/non_empty_string" }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object", "required": ["evaluation", "rows"],
      "properties": {
        "evaluation": { "enum": ["complete", "incomplete"] },
        "rows": { "$ref": "#/$defs/rows" },
        "skipped": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "skipped_details": {
          "$comment": "QRY-3: optional reasons for the paths in skipped, in the same order. Adapters compare code, rule_id, and field only; message is free text.",
          "type": "array",
          "items": {
            "type": "object", "required": ["path", "results"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "results": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reason" } }
            },
            "additionalProperties": false
          }
        },
        "unreadable": {
          "$comment": "QRY-5: optional notes whose frontmatter cannot be parsed and whose type cannot be known, in path order. Adapters compare path, code, rule_id, and field only.",
          "type": "array",
          "items": {
            "type": "object", "required": ["path", "results"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "results": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reason" } }
            },
            "additionalProperties": false
          }
        },
        "groups": { "type": "array", "items": {
          "type": "object", "required": ["key", "rows"],
          "properties": { "key": { "type": "array" }, "rows": { "$ref": "#/$defs/rows" } }, "additionalProperties": false
        } }
      },
      "additionalProperties": false
    }
  }
}
