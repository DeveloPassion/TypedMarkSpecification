{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developassion.github.io/TypedMarkSpecification/schema/property-set.schema.json",
  "title": "TypedMark property set (<metadata_directory>/property-sets/<property_set>.md frontmatter)",
  "description": "Frontmatter document shape; the artifact is a Markdown file whose YAML frontmatter is the governed content and whose body is non-normative. Authoritative semantics: property-sets.md. Semantic-layer checks include: file basename equals property_set, and relationship-target resolution against the composed collection. A property set must not declare storage, template, guidance, or any composition reference; additionalProperties: false enforces that here.",
  "type": "object",
  "required": [
    "specification_version",
    "property_set",
    "description",
    "frontmatter"
  ],
  "properties": {
    "specification_version": {
      "$ref": "defs.schema.json#/$defs/specification_version"
    },
    "property_set": {
      "$ref": "defs.schema.json#/$defs/slug"
    },
    "label": {
      "$ref": "defs.schema.json#/$defs/non_empty_string"
    },
    "icon": {
      "$ref": "defs.schema.json#/$defs/non_empty_string"
    },
    "description": {
      "$ref": "defs.schema.json#/$defs/non_empty_string"
    },
    "frontmatter": {
      "allOf": [
        {
          "$ref": "defs.schema.json#/$defs/frontmatter_block"
        },
        {
          "$ref": "defs.schema.json#/$defs/core_frontmatter_contract"
        },
        {
          "properties": {
            "id": false
          }
        }
      ]
    },
    "relationships": {
      "$ref": "defs.schema.json#/$defs/relationships_block"
    },
    "headings": {
      "$ref": "defs.schema.json#/$defs/headings_block"
    }
  },
  "patternProperties": {
    "^x_[a-z][a-z0-9_]*(?![\\s\\S])": {}
  },
  "additionalProperties": false
}
