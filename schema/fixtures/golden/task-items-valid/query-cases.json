        "value": false
      },
      "select": [
        {
          "kind": "path",
          "as": "path"
        }
      ]
    },
    "expected_error": "ITM-14"
  },
  {
    "name": "item-regex-on-integer-property",
    "query_version": "0.1.0",
    "rules": [
      "ITM-16"
    ],
    "query": {
      "specification_version": "0.1.0",
      "rows": "items",
      "where": {
        "kind": "item",
        "property": "line",
